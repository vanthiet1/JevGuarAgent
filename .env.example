# ==============================================================================
# Jev Omnichannel Guardrail (JOG) - Biến môi trường mẫu (.env.example)
# Sao chép tệp này thành .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KHÓA XÁC THỰC AI ENGINE (BẮT BUỘC: CHỈ CẦN OPENROUTER_API_KEY)
# ------------------------------------------------------------------------------
# Lấy API Key tại: https://openrouter.ai/settings/keys
# 👉 Bạn CHỈ CẦN cung cấp OpenRouter API Key.
# Hệ thống JEV Guardrail đã tự động tối ưu hóa và định tuyến model AI ngầm bên dưới,
# nhà phát triển hoàn toàn không cần phải bận tâm cấu hình model!
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# (Tùy chọn) Khóa TypeSafe AI (Nếu dự án dùng hạ tầng TypeSafe Enterprise riêng)
TYPESAFE_API_KEY=sk-or-v1-your-openrouter-or-typesafe-api-key-here
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH LOCAL INTERCEPTING PROXY (HTTP 403 INTERCEPTOR)
# ------------------------------------------------------------------------------
JOG_PROXY_HOST=127.0.0.1
JOG_PROXY_PORT=8080

# ------------------------------------------------------------------------------
# 3. NHẬT KÝ KIỂM TOÁN BẢO MẬT (AUDIT LOG)
# ------------------------------------------------------------------------------
JOG_AUDIT_LOG=.jog/logs/audit.log

# ------------------------------------------------------------------------------
# 4. NGƯỠNG RỦI RO (THRESHOLDS)
# ------------------------------------------------------------------------------
# Ngưỡng rò rỉ secret (0.0 -> 1.0): vượt quá mức này sẽ bị chặn (Mặc định: 0.6)
JOG_LEAK_THRESHOLD=0.6

# Ngưỡng bất ổn định kiến trúc code (0.0 -> 10.0): >= mức này sẽ bị chặn commit (Mặc định: 7.5)
JOG_STABILITY_THRESHOLD=7.5
