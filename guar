#!/usr/bin/env bash
# =============================================================================
# guar - Trình khởi chạy nhanh JevGuarAgent (macOS / Linux / Git Bash / WSL)
# =============================================================================
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PY_BIN="python"
elif command -v py >/dev/null 2>&1; then
    PY_BIN="py"
else
    echo "❌ Lỗi: Không tìm thấy Python 3 trên hệ thống! Vui lòng cài đặt Python." >&2
    exit 1
fi

exec "$PY_BIN" "$DIR/guar.py" "$@"
