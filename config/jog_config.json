{
  "api": {
    "typesafe_api_url": "https://api.typesafe.ai/v1/systemone",
    "typesafe_api_key": null,
    "timeout_seconds": 3.0,
    "enable_offline_fallback": true
  },
  "git_hook": {
    "leak_risk_threshold": 0.6,
    "production_stability_threshold": 7.5,
    "block_on_reject_verdict": true,
    "ignored_paths": ["tests/*", "*.md", "demo.sh", "test_*.sh", "bin/*", "*.bat", "*.cmd", "*.ps1"],
    "sensitive_filenames": [
      ".env", ".env.local", ".env.production", ".env.staging", ".env.development",
      "id_rsa", "id_ed25519", "id_dsa", "id_ecdsa",
      "service-account.json", "credentials.json", "secret.json",
      "private_key.pem", "server.key", "auth_token.txt"
    ]
  },
  "cli": {
    "require_confirmation_on_warn": true,
    "auto_abort_on_block": true
  },
  "logging": {
    "audit_log_file": ".jog/logs/audit.log",
    "log_level": "INFO"
  }
}
