from typing import Any, Dict

def format_colored_json(obj: Any, indent_prefix: str = "    ") -> str:
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    RESET = "\033[0m"

    raw = json.dumps(obj, indent=2, ensure_ascii=False)
    colored_lines = []
    for line in raw.splitlines():
        l = re.sub(r'(".*?")(?=\s*:)', f"{CYAN}\\1{RESET}", line)
        l = re.sub(r'(:\s*)(".*?")', f"\\1{GREEN}\\2{RESET}", l)
        l = re.sub(r'(:\s*)(true|false|null|-?\d+(?:\.\d+)?)', f"\\1{YELLOW}\\2{RESET}", l)
        l = re.sub(r'(^\s*)(".*?")(,?)$', f"\\1{GREEN}\\2{RESET}\\3", l)
        colored_lines.append(indent_prefix + l)
    return "\n".join(colored_lines)

def cmd_check_prompt(args):
    text = " ".join(args.text)
    if not text.strip() and not sys.stdin.isatty():
        text = sys.stdin.read().strip()

    if not text:
        print("Vui lòng cung cấp nội dung cần kiểm tra. Ví dụ: jog check prompt 'rm -rf /'")
        sys.exit(1)

    config = load_config()
    engine = JevEngine(config)
    res = engine.check_prompt_and_action(text, channel="cli_manual_check")
    advisory = engine.predict_architecture_advisory(text)

    if getattr(args, "json", False):
        out_dict = res.to_dict()
        out_dict["predicted_edge_cases"] = advisory.to_dict() if advisory else None
        print(json.dumps(out_dict, indent=2, ensure_ascii=False))
        sys.exit(0 if res.action_verdict == "allow" else (1 if res.action_verdict == "block_immediately" else 2))

    score = res.destructive_intent_score
    if score <= 3.0:
        level_txt = "An toàn"
    elif score <= 6.9:
        level_txt = "Cảnh báo"
    else:
        level_txt = "Cực kỳ nghiêm trọng"

    verdict_vi = "Cho phép" if res.action_verdict == "allow" else ("Cảnh báo rủi ro" if res.action_verdict == "warn_user" else "Chặn ngay lập tức")
    leak_vi = "Có (Phát hiện thông tin bí mật / API Key)" if res.has_credential_leak else "Không"
    remediation_vi = res.remediation if res.remediation else "Không cần sửa đổi"

    print("\n" + "─" * 65)
    print("🛡️  KẾT QUẢ ĐÁNH GIÁ AN TOÀN & Ý ĐỊNH HỆ THỐNG")
    print("─" * 65)
    print(f"1 - Kết luận hành động: {verdict_vi}")
    print(f"2 - Điểm số ý định phá hoại: {score}/10 ({level_txt})")
    print(f"3 - Phát hiện lộ bí mật / API Key: {leak_vi}")
    print(f"4 - Nguồn thẩm định: {res.engine_source}")
    print("5 - Chi tiết phân tích:")
    for d in res.details:
        print(f"    • {d}")
    print(f"6 - Hướng dẫn sửa đổi: {remediation_vi}")

    if advisory:
        print("\n🧠 PHỎNG ĐOÁN RỦI RO KIẾN TRÚC & EDGE CASES TƯƠNG LAI:")
        print(f"  • Ý định phát hiện: {advisory.intent_description}")
        print("  • Các rủi ro/Edge Cases tiềm ẩn cần phòng ngừa:")
        for rf in advisory.risk_factors:
            print(f"      ⚠️  {rf}")
        print("  • Mô hình kiến trúc tối ưu khuyến nghị:")
        for rp in advisory.recommended_patterns:
            print(f"      ✓  {rp}")
        print("\n  📌 Chỉ thị quy chuẩn cho Agent:")
        for line in advisory.injected_prompt_directive.splitlines():
            print(f"      {line}")

    print("─" * 65 + "\n")

    sys.exit(0 if res.action_verdict == "allow" else (1 if res.action_verdict == "block_immediately" else 2))

def cmd_check_code(args):
    target = args.file_or_snippet
    code_content = ""
    file_path = None

    if os.path.isfile(target):
        file_path = target
        with open(target, "r", encoding="utf-8", errors="replace") as f:
            code_content = f.read()
    else:
        code_content = target

    config = load_config()
    engine = JevEngine(config)
    res = engine.check_code_health(code_content, file_path=file_path, channel="cli_code_check")

    if getattr(args, "json", False):
        print(json.dumps(res.to_dict(), indent=2, ensure_ascii=False))
        sys.exit(0 if res.maintainability_verdict == "pass" else (1 if res.maintainability_verdict == "reject_force_agent_rewrite" else 2))

    stability = res.production_stability_score
    if stability <= 3.0:
        stab_txt = "An toàn"
    elif stability <= 6.9:
        stab_txt = "Cảnh báo"
    else:
        stab_txt = "Cực kỳ nghiêm trọng"

    maintain_vi = "Đạt chuẩn" if res.maintainability_verdict == "pass" else ("Cần tái cấu trúc" if res.maintainability_verdict == "warn_dev_needs_refactor" else "Bắt buộc viết lại")
    sec_risk_vi = "Có nguy cơ an ninh" if res.future_security_risk else "Không"
    leak_code_vi = "Có nguy cơ rò rỉ" if res.leak_risk > 0.3 else "Không"

    print("\n" + "─" * 65)
    print("🔬 KẾT QUẢ CHẨN ĐOÁN MÃ NGUỒN TƯƠNG LAI")
    print("─" * 65)
    print(f"1 - Kết luận bảo trì mã nguồn: {maintain_vi}")
    print(f"2 - Điểm số ổn định sản xuất: {stability}/10 ({stab_txt})")
    print(f"3 - Phân loại lỗi kiến trúc: {res.architecture_flaw_type}")
    print(f"4 - Rủi ro an ninh tương lai: {sec_risk_vi}")
    print(f"5 - Nguy cơ rò rỉ thông tin bí mật: {leak_code_vi}")
    print(f"6 - Nguồn thẩm định: {res.engine_source}")
    print("7 - Các vấn đề phát hiện:")
    if res.detected_flaws:
        for flaw in res.detected_flaws:
            print(f"    • {flaw}")
    else:
        print("    • Không phát hiện lỗi nghiêm trọng")
    print("8 - Hướng dẫn sửa đổi:")
    if res.remediation_suggestions:
        for rec in res.remediation_suggestions:
            print(f"    • {rec}")
    else:
        print("    • Không cần sửa đổi")
    print("─" * 65 + "\n")

    sys.exit(0 if res.maintainability_verdict == "pass" else (1 if res.maintainability_verdict == "reject_force_agent_rewrite" else 2))

def safe_cwd() -> Path:
    try:
        return Path.cwd().resolve()
    except (FileNotFoundError, OSError):
        pwd = os.environ.get("PWD")
        if pwd and Path(pwd).exists():
            return Path(pwd).resolve()
        return BASE_DIR

def get_target_project(target_arg=None) -> Path:
    if target_arg:
        return Path(target_arg).resolve()
    cwd = safe_cwd()
    if (cwd / ".git").exists() or (cwd / "package.json").exists() or (cwd / ".agents").exists():
        return cwd
    if (BASE_DIR / ".git").exists() or (BASE_DIR / "package.json").exists():
        return BASE_DIR
    parent = BASE_DIR.parent
    if (parent / ".git").exists() or (parent / "package.json").exists():
        return parent
    return cwd

