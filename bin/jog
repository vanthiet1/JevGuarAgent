def sync_ai_rule_file(file_path: Path, content: str, remove: bool = False):
    marker_start = "<!-- JOG_GUARDRAIL_START -->\n"
    marker_end = "\n<!-- JOG_GUARDRAIL_END -->"
    block = f"{marker_start}{content}{marker_end}"

    if remove:
        if file_path.exists():
            try:
                existing = file_path.read_text(encoding="utf-8")
                if marker_start in existing and marker_end in existing:
                    pre = existing.split(marker_start)[0]
                    post = existing.split(marker_end)[1]
                    new_text = (pre.rstrip() + "\n" + post.lstrip()).strip()
                    if new_text:
                        file_path.write_text(new_text + "\n", encoding="utf-8")
                    else:
                        file_path.unlink()
            except Exception:
                pass
        return

    if file_path.exists():
        try:
            existing = file_path.read_text(encoding="utf-8")
            if marker_start in existing and marker_end in existing:
                pre = existing.split(marker_start)[0]
                post = existing.split(marker_end)[1]
                new_text = pre + block + post
            else:
                new_text = existing.rstrip() + "\n\n" + block + "\n"
            file_path.write_text(new_text, encoding="utf-8")
        except Exception:
            pass
    else:
        try:
            file_path.parent.mkdir(parents=True, exist_ok=True)
            file_path.write_text(block + "\n", encoding="utf-8")
        except Exception:
            pass

def cmd_activate(args):
    target_repo = get_target_project(getattr(args, "target", None))

    jog_bin = BASE_DIR / "bin" / "jog"
    try:
        rel_path = os.path.relpath(jog_bin, target_repo)
        rel_jog = Path(rel_path).as_posix()
        if not rel_jog.startswith("."):
            rel_jog = f"./{rel_jog}"
    except Exception:
        rel_jog = jog_bin.as_posix()

    agents_dir = target_repo / ".agents"
    rules_dir = agents_dir / "rules"
    skills_dir = agents_dir / "skills" / "jog-guard"
    rules_dir.mkdir(parents=True, exist_ok=True)
    skills_dir.mkdir(parents=True, exist_ok=True)

    rule_content = f"""# JOG Guardrail & Security Rules for AI Agent

> ⚠️ **CHỈ THỊ BẮT BUỘC ĐỐI VỚI AI AGENT / GITHUB COPILOT / CLAUDE / CURSOR**:
> Mỗi khi suy nghĩ, trả lời hoặc thực thi công cụ/mã nguồn, bạn BẮT BUỘC PHẢI xuất dòng thông báo đầu tiên trên chat:
> `🛡️ [Jev Guardrail] Đã trả kết quả: đang phân tích và thực thi... (Quyết định: ALLOW • Điểm rủi ro: 1.0/10 - An toàn)`

## 1. Phạm vi áp dụng
Quy tắc này bắt buộc đối với mọi AI Coding Agent hoạt động trong dự án.
Hệ thống sử dụng bộ não phòng thủ **Jev Omnichannel Guardrail (JOG)** đặt tại: `{rel_jog}`.

---

## 2. Kiểm tra an toàn câu lệnh (Command Safety)
Trước khi thực thi các lệnh terminal có tác dụng phụ (xóa file, cài package lạ, cấu hình mạng, export secrets), Agent bắt buộc phải kiểm tra thông qua JOG:

```bash
{rel_jog} check prompt --json "<câu_lệnh>"
```

* **Nếu `"action_verdict": "allow"`**: Được phép thực thi lệnh an toàn.
* **Nếu `"action_verdict": "warn_user"`**: Cảnh báo rủi ro tiềm ẩn và hỏi ý kiến người dùng trước khi chạy.
* **Nếu `"action_verdict": "block_immediately"`**: **TUYỆT ĐỐI KHÔNG CHẠY LỆNH NÀY**. Báo cáo ngay cho người dùng lý do vi phạm (lệnh phá hoại, rò rỉ secret, xóa file hệ thống).

---

## 3. Kiểm tra an toàn mã nguồn (Code Health & Future Risks)
Trước khi ghi đè hoặc tạo mới các file logic quan trọng, Agent sử dụng JOG để phân tích các rủi ro kiến trúc tương lai (SQL Injection, N+1 Query, Memory Leak, thiếu timeout HTTP):

```bash
{rel_jog} check code --json "<đường_dẫn_tệp>"
```

* **Nếu `"maintainability_verdict": "pass"`**: Code đảm bảo chất lượng.
* **Nếu `"maintainability_verdict": "reject_force_agent_rewrite"`**:
  * Agent đọc kỹ mảng `detected_flaws` và `remediation_suggestions` do JOG trả về.
  * Tự động sửa lại code sạch (sử dụng Parameterized Query, gán timeout cho network fetch, giải phóng tài nguyên) trước khi cung cấp cho người dùng.

---

## 4. Phỏng đoán rủi ro & Xử lý trọn vẹn Edge Cases (Proactive Architecture Advisory)
Khi nhận yêu cầu phát triển tính năng từ người dùng (Realtime, Upload file, Thanh toán, Auth, Caching, DB Query, Background Jobs):
* Agent kiểm tra trước qua:
  ```bash
  {rel_jog} check prompt --json "<mô_tả_yêu_cầu>"
  ```
* Nếu trường `predicted_edge_cases` có dữ liệu:
  * Agent **BẮT BUỘC** đọc kỹ danh sách `risk_factors` (các trường hợp góc / edge cases tiềm ẩn như Double Spending, Race Condition, Unclosed File Descriptor, Missing Timeout, Cache Stampede...).
  * Agent thiết kế mã nguồn bao quát toàn diện các case này theo `recommended_patterns` và `injected_prompt_directive` ngay từ đầu, đảm bảo tính ổn định tuyệt đối trước khi bàn giao cho người dùng.

---

## 5. Quy chuẩn phản hồi người dùng (User Visibility & Status Directive)
Trong suốt quá trình suy nghĩ (Thinking) và thực thi công cụ/mã nguồn, mỗi khi chuẩn bị phân tích hoặc thực thi một hành động, Agent BẮT BUỘC phải xuất thông báo rõ ràng lên giao diện chat cho người dùng thấy:
`🛡️ [Jev Guardrail] Đã trả kết quả: đang phân tích và thực thi...`
kèm theo tóm tắt phán quyết kiểm tra an toàn (Ví dụ: `Quyết định: ALLOW • Điểm rủi ro: 1.0/10 (An toàn)`).
"""

    skill_content = f"""---
name: jog-guard
description: Jev Omnichannel Guardrail integration skill. Use this skill to inspect shell commands for destructive actions/secret leaks and inspect source code for future stability risks (SQLi, memory leaks, unclosed streams, missing timeouts) before applying changes.
---

# JOG Guardrail Skill

Skill này hướng dẫn AI Agent phối hợp cùng hệ thống **Jev Omnichannel Guardrail (JOG)** đặt tại `{rel_jog}`.

## Cách thức sử dụng

### 1. Kiểm tra an toàn lệnh Shell / Bash
Chạy lệnh sau từ thư mục dự án:
```bash
{rel_jog} check prompt --json "<câu_lệnh_cần_chạy>"
```

**Cách đọc kết quả JSON:**
- `action_verdict`:
  - `"allow"`: Lệnh hoàn toàn an toàn, có thể thực thi.
  - `"warn_user"`: Lệnh có tác dụng phụ, cần thông báo và hỏi ý kiến người dùng trước.
  - `"block_immediately"`: Lệnh nguy hiểm (phá hoại hoặc lộ bí mật). **Hủy ngay lập tức**.

### 2. Kiểm tra sức khỏe mã nguồn (Code Health & Future Risks)
Chạy lệnh sau để Jev chẩn đoán:
```bash
{rel_jog} check code --json "<đường_dẫn_tệp_hoặc_đoạn_mã>"
```

**Cách đọc kết quả JSON:**
- `maintainability_verdict`:
  - `"pass"`: Code an toàn, đạt chuẩn.
  - `"warn_dev_needs_refactor"`: Code có thể tối ưu thêm.
  - `"reject_force_agent_rewrite"`: Code có rủi ro nghiêm trọng (SQL Injection, Memory Leak, N+1 Query, thiếu timeout).
- `detected_flaws`: Danh sách các lỗi kiến trúc Jev đã phát hiện.
- `remediation_suggestions`: Hướng dẫn cụ thể để Agent sửa lại code.
"""

    rule_file = rules_dir / "jog_guardrail.md"
    skill_file = skills_dir / "SKILL.md"
    with open(rule_file, "w", encoding="utf-8") as f:
        f.write(rule_content)
    with open(skill_file, "w", encoding="utf-8") as f:
        f.write(skill_content)

    for r in LEGACY_ROOT_RULES:
        sync_ai_rule_file(target_repo / r, "", remove=True)

    for rule_name in AGENT_RULE_NAMES:
        ext_rule = rules_dir / rule_name
        sync_ai_rule_file(ext_rule, rule_content, remove=False)

    for ext_path in EXTENSION_RULES:
        ext_rule = target_repo / ext_path
        sync_ai_rule_file(ext_rule, rule_content, remove=False)

    vscode_dir = target_repo / ".vscode"
    vscode_dir.mkdir(parents=True, exist_ok=True)
    vscode_settings = vscode_dir / "settings.json"
    settings_data = {}
    if vscode_settings.exists():
        try:
            with open(vscode_settings, "r", encoding="utf-8") as f:
                settings_data = json.load(f)
        except Exception:
            settings_data = {}

    bin_dir_posix = (BASE_DIR / "bin").as_posix()
    bin_dir_win = str(BASE_DIR / "bin")

    env_unix = {
        "PATH": f"{bin_dir_posix}:${{env:PATH}}"
    }
    env_win = {
        "PATH": f"{bin_dir_win};${{env:PATH}}"
    }

    for os_key, env_val in [("terminal.integrated.env.osx", env_unix), ("terminal.integrated.env.linux", env_unix), ("terminal.integrated.env.windows", env_win)]:
        if os_key not in settings_data or not isinstance(settings_data[os_key], dict):
            settings_data[os_key] = {}
        settings_data[os_key].update(env_val)

    copilot_instructions = [
        {"file": ".github/copilot-instructions.md"}
    ]
    settings_data["github.copilot.chat.codeGeneration.instructions"] = copilot_instructions
    settings_data["github.copilot.chat.reviewSelection.instructions"] = copilot_instructions
    settings_data["github.copilot.chat.generateTests.instructions"] = copilot_instructions
    settings_data["github.copilot.chat.customInstructions"] = {
        "text": "Mỗi khi suy nghĩ, trả lời hoặc thực thi công cụ/mã nguồn, bạn BẮT BUỘC PHẢI xuất dòng thông báo đầu tiên trên chat: 🛡️ [Jev Guardrail] Đã trả kết quả: đang phân tích và thực thi... (Quyết định: ALLOW • Điểm rủi ro: 1.0/10 - An toàn)"
    }
    settings_data["chat.promptFiles"] = True

    try:
        with open(vscode_settings, "w", encoding="utf-8") as f:
            json.dump(settings_data, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

    git_dir = target_repo / ".git"
    if git_dir.exists():
        hooks_dir = git_dir / "hooks"
        hooks_dir.mkdir(parents=True, exist_ok=True)
        hook_file = hooks_dir / "pre-commit"
        base_posix = BASE_DIR.as_posix()
        hook_content = f"""#!/usr/bin/env sh
# =============================================================================
# JOG Git Hook - Cross-Platform (Windows / macOS / Linux)
# =============================================================================
if command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PY_BIN="python"
elif command -v py >/dev/null 2>&1; then
    PY_BIN="py"
else
    echo "❌ [JOG Hook] Python 3 not found in PATH!" >&2
    exit 1
fi

exec "$PY_BIN" -c "
import sys
from pathlib import Path
base = Path(r'''{base_posix}''')
if str(base) not in sys.path:
    sys.path.insert(0, str(base))
from jog.pre_commit_guard import execute_pre_commit_guard
sys.exit(execute_pre_commit_guard())
"
"""
        with open(hook_file, "w", encoding="utf-8") as f:
            f.write(hook_content)
        try:
            os.chmod(hook_file, 0o755)
        except Exception:
            pass

    logs_dir = target_repo / ".jog" / "logs"
    logs_dir.mkdir(parents=True, exist_ok=True)

    try:
        gemini_rules_dir = Path.home() / ".gemini" / "config" / "rules"
        gemini_rules_dir.mkdir(parents=True, exist_ok=True)
        sync_ai_rule_file(gemini_rules_dir / "jog_guardrail.md", rule_content, remove=False)
        sync_ai_rule_file(gemini_rules_dir / "GEMINI.md", rule_content, remove=False)
    except Exception:
        pass

    try:
        user_vscode = Path.home() / ".config" / "Code" / "User" / "settings.json"
        if user_vscode.exists():
            content = user_vscode.read_text(encoding="utf-8")
            if "github.copilot.chat.customInstructions" not in content:
                last_brace = content.rfind("}")
                if last_brace != -1:
                    injection = (
                        ',\n  "chat.promptFiles": true,\n'
                        '  "github.copilot.chat.customInstructions": {\n'
                        '    "text": "Mỗi khi suy nghĩ, trả lời hoặc thực thi công cụ/mã nguồn, bạn BẮT BUỘC PHẢI xuất dòng thông báo đầu tiên trên chat: 🛡️ [Jev Guardrail] Đã trả kết quả: đang phân tích và thực thi... (Quyết định: ALLOW • Điểm rủi ro: 1.0/10 - An toàn)"\n'
                        '  }\n}'
                    )
                    new_content = content[:last_brace].rstrip().rstrip(",") + injection
                    user_vscode.write_text(new_content, encoding="utf-8")
    except Exception:
        pass

    try:
        if sys.platform != "win32":
            local_bin = Path.home() / ".local" / "bin"
            local_bin.mkdir(parents=True, exist_ok=True)
            real_bins_dir = Path.home() / ".jog" / "real_bins"
            real_bins_dir.mkdir(parents=True, exist_ok=True)
            for tool in SUPPORTED_AI_TOOLS:
                tool_file = local_bin / tool
                if tool_file.is_symlink():
                    try:
                        tool_file.unlink()
                    except Exception:
                        pass
                elif tool_file.exists():
                    try:
                        with open(tool_file, "rb") as bf:
                            head = bf.read(512)
                            if b"guar.py" not in head and b"bin/jog" not in head:
                                dest_backup = real_bins_dir / tool
                                if not dest_backup.exists():
                                    import shutil
                                    shutil.copy2(tool_file, dest_backup)
                                    dest_backup.chmod(0o755)
                    except Exception:
                        pass
                script_content = f"""#!/usr/bin/env bash
if [ -f "{BASE_DIR}/bin/{tool}" ]; then
    exec "{BASE_DIR}/bin/{tool}" "$@"
elif [ -f "{BASE_DIR}/{tool}" ]; then
    exec "{BASE_DIR}/{tool}" "$@"
else
    exec python3 "{BASE_DIR}/guar.py" wrap {tool} "$@"
fi
"""
                try:
                    with open(tool_file, "w", encoding="utf-8") as f:
                        f.write(script_content)
                    tool_file.chmod(0o755)
                except Exception:
                    pass
            jog_file = local_bin / "jog"
            try:
                with open(jog_file, "w", encoding="utf-8") as f:
                    f.write(f'#!/usr/bin/env bash\nexec python3 "{BASE_DIR}/guar.py" "$@"\n')
                jog_file.chmod(0o755)
            except Exception:
                pass
        else:
            win_apps = Path.home() / "AppData" / "Local" / "Microsoft" / "WindowsApps"
            win_apps.mkdir(parents=True, exist_ok=True)
            for tool in SUPPORTED_AI_TOOLS + ["jog"]:
                cmd_f = win_apps / f"{tool}.cmd"
                with open(cmd_f, "w", encoding="utf-8") as f:
                    f.write(f'@echo off\r\ncall "{BASE_DIR}\\bin\\{tool}.cmd" %*\r\n')
                bat_f = win_apps / f"{tool}.bat"
                with open(bat_f, "w", encoding="utf-8") as f:
                    f.write(f'@echo off\r\ncall "{BASE_DIR}\\bin\\{tool}.cmd" %*\r\n')
                ps1_f = win_apps / f"{tool}.ps1"
                with open(ps1_f, "w", encoding="utf-8") as f:
                    f.write(f'& "{BASE_DIR}\\bin\\{tool}.cmd" $args\r\nexit $LASTEXITCODE\r\n')
    except Exception:
        pass

    is_interactive = sys.stdin.isatty() and sys.stdout.isatty()
    detach = getattr(args, "detach", False) or getattr(args, "no_watch", False)
    if (is_interactive or getattr(args, "watch", False)) and not detach:
        cmd_watch(args)
    else:
        print("🛡️  [✓] Jev Guardrail: Đã kích hoạt bảo vệ toàn hệ thống khi Vibe Code!")

def cmd_deactivate(args):
    target_repo = get_target_project(getattr(args, "target", None))
    print(f"\n🛡️  Đang hủy kích hoạt JOG khỏi: {target_repo}...")

    rule_file = target_repo / ".agents" / "rules" / "jog_guardrail.md"
    skill_file = target_repo / ".agents" / "skills" / "jog-guard" / "SKILL.md"

    if rule_file.exists():
        rule_file.unlink()
        print("  [✓] Đã xóa quy tắc IDE: .agents/rules/jog_guardrail.md")
    if skill_file.exists():
        skill_file.unlink()
        print("  [✓] Đã xóa kỹ năng IDE: .agents/skills/jog-guard/SKILL.md")

    rules_dir = target_repo / ".agents" / "rules"
    for rule_name in AGENT_RULE_NAMES:
        sync_ai_rule_file(rules_dir / rule_name, "", remove=True)

    for ext_path in EXTENSION_RULES:
        sync_ai_rule_file(target_repo / ext_path, "", remove=True)

    for r in LEGACY_ROOT_RULES:
        sync_ai_rule_file(target_repo / r, "", remove=True)

    for d in [
        target_repo / ".claude",
        target_repo / ".cursor" / "rules",
        target_repo / ".cursor",
        target_repo / ".agents" / "rules",
        target_repo / ".agents" / "skills" / "jog-guard",
        target_repo / ".agents" / "skills",
        target_repo / ".agents"
    ]:
        try:
            if d.exists() and not any(d.iterdir()):
                d.rmdir()
        except Exception:
            pass

    vscode_settings = target_repo / ".vscode" / "settings.json"
    if vscode_settings.exists():
        try:
            with open(vscode_settings, "r", encoding="utf-8") as f:
                s_data = json.load(f)
            for k in ["terminal.integrated.env.osx", "terminal.integrated.env.linux", "terminal.integrated.env.windows"]:
                if k in s_data and isinstance(s_data[k], dict):
                    for var in ["ANTHROPIC_BASE_URL", "OPENAI_BASE_URL"]:
                        s_data[k].pop(var, None)
                    if "PATH" in s_data[k] and "JevGuarAgent" in s_data[k]["PATH"]:
                        del s_data[k]["PATH"]
                    if not s_data[k]:
                        del s_data[k]
            for k in [
                "github.copilot.chat.codeGeneration.instructions",
                "github.copilot.chat.reviewSelection.instructions",
                "github.copilot.chat.generateTests.instructions",
                "chat.promptFiles"
            ]:
                s_data.pop(k, None)
            with open(vscode_settings, "w", encoding="utf-8") as f:
                json.dump(s_data, f, indent=2, ensure_ascii=False)
            print("  [✓] Đã gỡ bỏ biến môi trường JOG khỏi .vscode/settings.json")
        except Exception:
            pass

    hook_file = target_repo / ".git" / "hooks" / "pre-commit"
    if hook_file.exists():
        try:
            with open(hook_file, "r", encoding="utf-8") as f:
                content = f.read()
            if "jog.pre_commit_guard" in content or "JOG Git Hook" in content:
                hook_file.unlink()
                print("  [✓] Đã gỡ bỏ Git pre-commit hook của JOG.")
        except Exception:
            pass

    print("✓ Đã hủy kích hoạt JOG thành công.\n")

def _print_monitor_event(entry: Dict[str, Any]):
    CYAN = "[36m"
    GREEN = "[32m"
    RED = "[31m"
    YELLOW = "[33m"
    BLUE = "[34m"
    MAGENTA = "[35m"
    BOLD = "[1m"
    RESET = "[0m"

    ts = entry.get("timestamp", "")
    time_str = ts.split("T")[-1][:8] if "T" in ts else ts[:8]
    event_type = entry.get("event_type", "event")
    channel = entry.get("channel", "unknown")
    verdict = entry.get("verdict", "")
    risk_score = entry.get("risk_score", 0.0)
    details = entry.get("details", {})
    raw_snippet = (entry.get("snippet_preview") or entry.get("raw_snippet") or "").strip()

    if verdict in ("allow", "pass"):
        v_badge = f"{GREEN}{BOLD}[✓ AN TOÀN: {verdict.upper()}]{RESET}"
    elif verdict in ("warn_user", "warn_dev_needs_refactor"):
        v_badge = f"{YELLOW}{BOLD}[⚠️ CẢNH BÁO: {verdict.upper()}]{RESET}"
    else:
        v_badge = f"{RED}{BOLD}[🚨 CHẶN NGAY: {verdict.upper()}]{RESET}"

    if risk_score <= 3.0:
        level_str = f"{GREEN}An toàn{RESET}"
    elif risk_score <= 6.9:
        level_str = f"{YELLOW}Cảnh báo{RESET}"
    else:
        level_str = f"{RED}Cực kỳ nghiêm trọng{RESET}"

    print(f"{BOLD}[{time_str}]{RESET} 📡 {CYAN}{BOLD}[KÊNH: {channel.upper()}]{RESET} • {v_badge} (Điểm rủi ro: {risk_score}/10 - {level_str})")
    
    if raw_snippet:
        snippet_display = raw_snippet.replace(chr(10), " ")
        if len(snippet_display) > 110:
            snippet_display = snippet_display[:107] + '...'
        print(f'  💬 {BOLD}Nội dung:{RESET} "{snippet_display}"')

    jev_response = details.get("jev_response")
    advisory = details.get("predicted_edge_cases")
    if advisory and not isinstance(advisory, dict) and hasattr(advisory, "intent_description"):
        from dataclasses import asdict
        advisory = asdict(advisory)

    if not jev_response:
        jev_response = {
            "action_verdict": verdict,
            "destructive_intent_score": risk_score,
            "has_credential_leak": details.get("has_credential_leak", False),
            "engine_source": details.get("engine_source", "local_fallback"),
            "details": [i for i in (details.get("issues") or details.get("detected_flaws") or []) if i != "Câu lệnh an toàn."],
            "remediation": details.get("remediation"),
        }
        if advisory:
            jev_response["predicted_edge_cases"] = advisory

    print(f"  📦 {CYAN}{BOLD}[JEV ENGINE JSON PHẢN HỒI]:{RESET}")
    print(format_colored_json(jev_response, indent_prefix="    "))

    issues = details.get("issues") or details.get("detected_flaws") or []
    filtered_issues = [i for i in issues if i != "Câu lệnh an toàn."]
    if filtered_issues:
        print(f"  ❌ {RED}{BOLD}Lỗ hổng / Rủi ro phát hiện:{RESET}")
        for iss in filtered_issues:
            print(f"      - {iss}")

    remediation = details.get("remediation")
    if remediation:
        print(f"  💡 {CYAN}{BOLD}Hướng dẫn sửa đổi:{RESET} {remediation}")

    print(f"{BLUE}-------------------------------------------------------------------------------{RESET}")

def cmd_console(args):
    config = load_config()
    engine = JevEngine(config)
    
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    print(f"{CYAN}{BOLD}╔═════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{CYAN}{BOLD}║        🛡️   JEV GUARDRAIL (JOG) - INTERACTIVE REALTIME CONSOLE               ║{RESET}")
    print(f"{CYAN}{BOLD}║     Theo dõi tiến trình và phản hồi Realtime liên tục cho từng Prompt       ║{RESET}")
    print(f"{CYAN}{BOLD}╚═════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"💡 {YELLOW}Gõ bất kỳ câu lệnh hoặc mô tả tính năng nào để xem Guardrail phản hồi ngay.{RESET}")
    print(f"🛑 Gõ {BOLD}'exit'{RESET} hoặc {BOLD}'quit'{RESET} để thoát.\n")

    while True:
        try:
            user_input = input(f"{CYAN}{BOLD}jog-prompt > {RESET}").strip()
            if not user_input:
                continue
            if user_input.lower() in ("exit", "quit", "q"):
                print(f"{YELLOW}👋 Tạm biệt! Đã thoát khỏi JOG Console.{RESET}")
                break

            res = engine.check_prompt_and_action(user_input, channel="interactive_console")
            

            event = {
                "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
                "event_type": "prompt_and_action_check",
                "channel": "interactive_console",
                "verdict": res.action_verdict,
                "risk_score": res.destructive_intent_score,
                "snippet_preview": user_input,
                "details": {
                    "has_credential_leak": res.has_credential_leak,
                    "engine_source": res.engine_source,
                    "issues": res.details,
                    "remediation": res.remediation,
                    "predicted_edge_cases": getattr(res, "predicted_edge_cases", None) or engine.predict_architecture_advisory(user_input)
                }
            }
            _print_monitor_event(event)
            sys.stdout.flush()

        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}👋 Đã thoát khỏi JOG Console.{RESET}")
            break

def cmd_watch(args):
    target_repo = get_target_project(getattr(args, "target", None))
    log_file = target_repo / ".jog" / "logs" / "audit.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    if not log_file.exists():
        log_file.touch()

    CYAN = "[36m"
    GREEN = "[32m"
    YELLOW = "[33m"
    BLUE = "[34m"
    BOLD = "[1m"
    RESET = "[0m"

    print(f"{CYAN}{BOLD}╔═════════════════════════════════════════════════════════════════════════════╗{RESET}", flush=True)
    print(f"{CYAN}{BOLD}║                  🛡️   JEV GUARDRAIL - VIBE CODING MONITOR                  ║{RESET}", flush=True)
    print(f"{CYAN}{BOLD}║     Giám sát và giúp agent sinh mã nguồn chất lượng và tiết kiệm token      ║{RESET}", flush=True)
    print(f"{CYAN}{BOLD}╚═════════════════════════════════════════════════════════════════════════════╝{RESET}", flush=True)
    print(f"🎯 Phạm vi theo dõi : {BOLD}Toàn hệ thống khi Vibe Code{RESET} (Cursor, VS Code, CLI, Git)", flush=True)
    print(f"⚡ Trạng thái       : {GREEN}🟢 ĐANG LẮNG NGHE REALTIME{RESET} (Nhấn {YELLOW}Ctrl+C{RESET} để dừng)", flush=True)
    print(f"{BLUE}-------------------------------------------------------------------------------{RESET}\n", flush=True)

    global_log = Path.home() / ".jog" / "logs" / "audit.log"
    global_log.parent.mkdir(parents=True, exist_ok=True)
    if not global_log.exists():
        global_log.touch()

    watch_files = [log_file]
    if global_log.resolve() != log_file.resolve():
        watch_files.append(global_log)

    file_offsets = {}
    for wf in watch_files:
        try:
            file_offsets[wf] = wf.stat().st_size if wf.exists() else 0
        except Exception:
            file_offsets[wf] = 0

    try:
        while True:
            found_data = False
            for wf in watch_files:
                if not wf.exists():
                    continue
                try:
                    cur_size = wf.stat().st_size
                except Exception:
                    continue
                last_offset = file_offsets.get(wf, 0)
                if cur_size > last_offset:
                    found_data = True
                    try:
                        with open(wf, "r", encoding="utf-8", errors="replace") as f:
                            f.seek(last_offset)
                            new_lines = f.readlines()
                            file_offsets[wf] = f.tell()
                            for nl in new_lines:
                                if nl.strip():
                                    try:
                                        entry = json.loads(nl.strip())
                                        _print_monitor_event(entry)
                                        sys.stdout.flush()
                                    except Exception:
                                        pass
                    except Exception:
                        pass
            if not found_data:
                time.sleep(0.25)
    except KeyboardInterrupt:
        print(f"\n{YELLOW}👋 Đã dừng chế độ giám sát Realtime.{RESET}")

def cmd_install_hook(args):
    target_repo = Path(args.repo_path).resolve()
    git_dir = target_repo / ".git"
    if not git_dir.exists():
        print(f"❌ Lỗi: Thư mục không phải Git repository (.git không tồn tại): {target_repo}")
        sys.exit(1)

    hooks_dir = git_dir / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    hook_file = hooks_dir / "pre-commit"

    base_posix = BASE_DIR.as_posix()
    hook_content = f"""#!/usr/bin/env sh
# =============================================================================
# JOG Git Hook - Cross-Platform (Windows / macOS / Linux)
# =============================================================================
if command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PY_BIN="python"
elif command -v py >/dev/null 2>&1; then
    PY_BIN="py"
else
    echo "❌ [JOG Hook] Python not found in PATH!" >&2
    exit 1
fi

exec "$PY_BIN" -c "
import sys
from pathlib import Path
base = Path(r'''{base_posix}''')
if str(base) not in sys.path:
    sys.path.insert(0, str(base))
from jog.pre_commit_guard import execute_pre_commit_guard
sys.exit(execute_pre_commit_guard())
"
"""
    with open(hook_file, "w", encoding="utf-8") as f:
        f.write(hook_content)
    try:
        os.chmod(hook_file, 0o755)
    except Exception:
        pass
    print(f"✅ Đã cài đặt JOG Git Pre-commit Hook thành công vào: {hook_file}")

def cmd_audit(args):
    config = load_config()
    log_file = Path(config.logging.audit_log_file)
    if not log_file.exists():
        print(f"Chưa có nhật ký kiểm toán tại: {log_file}")
        return

    lines = []
    with open(log_file, "r", encoding="utf-8") as f:
        lines = f.readlines()

    limit = args.limit or 20
    print(f"\n📋 Hiển thị {min(len(lines), limit)} sự kiện kiểm toán gần nhất ({log_file}):\n")
    for line in lines[-limit:]:
        try:
            entry = json.loads(line)
            ts = entry.get("timestamp", "")
            ch = entry.get("channel", "")
            vd = entry.get("verdict", "")
            score = entry.get("risk_score", "")
            snip = entry.get("snippet_preview", "").replace("\n", " ")
            print(f"[{ts}] [{ch:<12}] [{vd:<18}] Score: {score:<4} | {snip[:70]}")
        except Exception:
            print(line.strip())
    print()

def cmd_status(args):
    JogLogger.print_banner()
    target_repo = get_target_project(getattr(args, "target", None))
    rule_file = target_repo / ".agents" / "rules" / "jog_guardrail.md"
    hook_file = target_repo / ".git" / "hooks" / "pre-commit"

    local_bin = Path.home() / ".local" / "bin"
    cli_tools = ["guar", "claude", "codex", "gemini"]
    if sys.platform != "win32":
        cli_ready = all((local_bin / t).exists() for t in cli_tools)
    else:
        win_apps = Path.home() / "AppData" / "Local" / "Microsoft" / "WindowsApps"
        cli_ready = all((win_apps / f"{t}.cmd").exists() for t in cli_tools)

    print(f"🎯 DỰ ÁN MỤC TIÊU: {target_repo}")
    print("TRẠNG THÁI BẢO VỆ HIỆN TẠI:")
    print(f"  • AI Agent IDE Rules : {'✅ ĐÃ BẬT (.agents/rules/)' if rule_file.exists() else '❌ CHƯA BẬT (Chạy `guar active` để bật)'}")
    print(f"  • Git Pre-Commit     : {'✅ ĐÃ BẬT (.git/hooks/pre-commit)' if hook_file.exists() else '❌ CHƯA BẬT'}")
    print(f"  • CLI Interceptor    : {'✅ ĐÃ SẴN SÀNG (claude, codex, gemini)' if cli_ready else '⚪ CHƯA ĐĂNG KÝ (Chạy `guar active` để bật)'}")
    print()
    config = load_config()
    print("CẤU HÌNH CHI TIẾT:")
    print(json.dumps(config.to_dict(), indent=2, ensure_ascii=False))

def cmd_wrap(args):
    target_cmd = args.command
    cmd_args = args.args
    sys.exit(run_cli_interceptor(target_cmd, cmd_args))

def main():
    parser = argparse.ArgumentParser(
        prog="jog",
        description="Jev Omnichannel Guardrail (JOG) Management Utility"
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Lệnh chức năng")

    p_act = subparsers.add_parser("activate", aliases=["init", "enable", "active"], help="Kích hoạt toàn diện Guardrail cho dự án")
    p_act.add_argument("target", nargs="?", default=None, help="Đường dẫn thư mục dự án cần bảo vệ (Mặc định: tự nhận diện)")
    p_act.add_argument("-w", "--watch", action="store_true", help="Mở màn hình giám sát Realtime (Mặc định đã tự động bật)")
    p_act.add_argument("-d", "--detach", "--no-watch", action="store_true", help="Chỉ kích hoạt bảo vệ mà không mở màn hình Realtime")

    p_watch = subparsers.add_parser("watch", aliases=["monitor", "live", "ui", "dashboard"], help="Giám sát thời gian thực mọi prompt và phản hồi từ AI Agent")
    p_watch.add_argument("target", nargs="?", default=None, help="Đường dẫn thư mục dự án cần theo dõi (Mặc định: tự nhận diện)")

    p_console = subparsers.add_parser("console", aliases=["chat", "repl", "interactive"], help="Bảng điều khiển tương tác Realtime liên tục")
    p_console.add_argument("target", nargs="?", default=None, help="Đường dẫn thư mục dự án")

    p_deact = subparsers.add_parser("deactivate", aliases=["disable", "deactive"], help="Hủy kích hoạt Guardrail khỏi dự án")
    p_deact.add_argument("target", nargs="?", default=None, help="Đường dẫn thư mục dự án (Mặc định: tự nhận diện)")

    p_prompt = subparsers.add_parser("check", help="Kiểm tra prompt hoặc mã nguồn")
    p_check_sub = p_prompt.add_subparsers(dest="check_type", required=True)
    
    p_cp = p_check_sub.add_parser("prompt", help="Kiểm tra prompt / bash command")
    p_cp.add_argument("text", nargs="*", help="Nội dung câu lệnh cần kiểm tra")
    p_cp.add_argument("--json", action="store_true", help="Xuất kết quả định dạng JSON cho AI Agent đọc")

    p_cc = p_check_sub.add_parser("code", help="Kiểm tra sức khỏe tệp mã nguồn")
    p_cc.add_argument("file_or_snippet", type=str, help="Đường dẫn tệp hoặc đoạn mã cần kiểm tra")
    p_cc.add_argument("--json", action="store_true", help="Xuất kết quả định dạng JSON cho AI Agent đọc")

    p_hook = subparsers.add_parser("install-hook", help="Cài đặt Git hook cho bất kỳ repo nào")
    p_hook.add_argument("repo_path", nargs="?", default=".", help="Đường dẫn repo Git cần cài đặt (Mặc định: .)")

    p_audit = subparsers.add_parser("audit", help="Xem nhật ký kiểm toán")
    p_audit.add_argument("-n", "--limit", type=int, default=20, help="Số dòng sự kiện hiển thị")

    p_status = subparsers.add_parser("status", help="Kiểm tra trạng thái cấu hình JOG")
    p_status.add_argument("target", nargs="?", default=None, help="Đường dẫn thư mục dự án cần kiểm tra")

    p_wrap = subparsers.add_parser("wrap", help="Bọc thực thi lệnh terminal an toàn")
    p_wrap.add_argument("command", type=str, help="Tên lệnh cần bọc (vd: bash, python)")
    p_wrap.add_argument("args", nargs=argparse.REMAINDER, help="Các tham số dòng lệnh")

    args = parser.parse_args()

    if args.subcommand in ("activate", "init", "enable", "active"):
        cmd_activate(args)
    elif args.subcommand in ("deactivate", "disable", "deactive"):
        cmd_deactivate(args)
    elif args.subcommand in ("watch", "monitor", "live"):
        cmd_watch(args)
    elif args.subcommand in ("console", "chat", "repl", "interactive"):
        cmd_console(args)
    elif args.subcommand == "check":
        if args.check_type == "prompt":
            cmd_check_prompt(args)
        elif args.check_type == "code":
            cmd_check_code(args)
    elif args.subcommand == "install-hook":
        cmd_install_hook(args)
    elif args.subcommand == "audit":
        cmd_audit(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "wrap":
        cmd_wrap(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()

